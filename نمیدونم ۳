def create_evaluation_prompt(
    question,
    answer
):

    prompt = f"""

تو یک ارزیاب کیفیت پاسخ هستی.

سؤال کاربر:

{question}


پاسخ تولید شده:

{answer}


بررسی کن:

1. آیا پاسخ دقیق است؟
2. آیا کامل است؟
3. آیا واضح است؟
4. آیا چیزی کم دارد؟


اگر مشکل دارد، یک نسخه بهتر از پاسخ بنویس.

فقط پاسخ نهایی بهتر را خروجی بده.

"""


    return prompt
