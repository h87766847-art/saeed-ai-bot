import os
import py_compile
import datetime


def check_python_files():

    errors = []

    for file in os.listdir("."):
        if file.endswith(".py"):

            try:
                py_compile.compile(
                    file,
                    doraise=True
                )

            except Exception as e:
                errors.append(
                    {
                        "file": file,
                        "error": str(e)
                    }
                )

    return errors



def run_upgrade_test():

    print(
        "Saeed Upgrade Test Started..."
    )

    errors = check_python_files()

    if errors:

        print(
            "Upgrade Failed"
        )

        for err in errors:
            print(err)

        return False


    print(
        "Upgrade Test Passed ✅"
    )

    print(
        datetime.datetime.now()
    )

    return True



if __name__ == "__main__":
    run_upgrade_test()
